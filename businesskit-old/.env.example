# BusinessKit Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real credentials.

# ── Encryption Secret (32-byte hex string) ────────────────────────────────────
# Used for encrypting session and local cache tokens
ENCRYPTION_SECRET=your_32_byte_hex_encryption_secret_here

# ── Central Turso Database ───────────────────────────────────────────────────
# Connection details for the central registry database
TURSO_DATABASE_URL=https://your-central-db.turso.io
TURSO_AUTH_TOKEN=your_turso_central_auth_token_here

# ── WorkOS AuthKit ────────────────────────────────────────────────────────────
# OAuth credentials for desktop & mobile authentication
WORKOS_CLIENT_ID=your_workos_client_id_here
WORKOS_API_KEY=your_workos_api_key_here
WORKOS_REDIRECT_URI=http://localhost:4666/callback

# ── Paddle Billing ────────────────────────────────────────────────────────────
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_CHECKOUT_URL=https://sandbox-buy.paddle.com

# ── Cloudflare Deployments (Optional) ─────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ── AWS SES Email (Optional) ─────────────────────────────────────────────────
SES_REGION=us-east-1
SES_ACCESS_KEY=your_aws_access_key
SES_SECRET_KEY=your_aws_secret_key
SES_FROM_EMAIL=notifications@yourdomain.com
SES_FROM_NAME=BusinessKit

# ── AI Agents (Optional) ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
